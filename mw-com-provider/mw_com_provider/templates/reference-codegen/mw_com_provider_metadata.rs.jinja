pub const MW_COM_SERVICE_DEFS: &str = "reference-codegen";
pub const MW_COM_BINDINGS_AVAILABLE: bool = true;

pub fn describe_generated_bindings() -> &'static str {
    "mw::com provider metadata generated by the reference SCORE config code generator."
}

#[derive(Debug, Clone, Copy, Eq, PartialEq)]
pub struct GeneratedStructFieldAccessor {
    pub struct_name: &'static str,
    pub field_name: &'static str,
    pub datatype: &'static str,
    pub size: usize,
    pub alignment: usize,
}

#[derive(Debug, Clone, Copy, Eq, PartialEq)]
pub struct GenericMwComElement {
    pub service_name: &'static str,
    pub instance_name: &'static str,
    pub instance_specifier: &'static str,
    pub member_name: &'static str,
    pub element_kind: &'static str,
    pub payload_type: &'static str,
    pub sample_size: usize,
    pub sample_alignment: usize,
    pub has_serialized_format: bool,
}

pub const GENERATED_STRUCT_FIELD_ACCESSORS: &[GeneratedStructFieldAccessor] = &[
{% macro struct_fields(ns, path="") %}
{% set current = path ~ "::" ~ ns.name if path else ns.name %}
{% for str in ns.structs | default([]) %}
{% for member in str.members | default([]) %}
    GeneratedStructFieldAccessor { struct_name: "{{ current }}::{{ str.name }}", field_name: "{{ member.name }}", datatype: "{{ member.datatype }}", size: {{ member.sample_size | default(0) }}, alignment: {{ member.sample_alignment | default(1) }} },
{% endfor %}
{% endfor %}
{% for child in ns.namespaces | default([]) %}
{{ struct_fields(child, current) }}
{% endfor %}
{% endmacro %}
{% for ns in json.namespaces | default([]) %}
{{ struct_fields(ns) }}
{% endfor %}
];

pub const GENERATED_GENERIC_MW_COM_ELEMENTS: &[GenericMwComElement] = &[
{% macro generic_elements(ns, path="") %}
{% set current = path ~ "::" ~ ns.name if path else ns.name %}
{% for intf in ns.interfaces | default([]) %}
{% for event in intf.events | default([]) %}
{% if event.provider is defined %}
    GenericMwComElement { service_name: "{{ event.provider.service | default(intf.name) }}", instance_name: "{{ event.provider.instance | default(current) }}", instance_specifier: "{{ event.provider.instance_specifier | default(event.provider.instance | default(current)) }}", member_name: "{{ event.name }}", element_kind: "event", payload_type: "{{ event.datatype }}", sample_size: {{ event.sample_size | default(0) }}, sample_alignment: {{ event.sample_alignment | default(1) }}, has_serialized_format: {{ event.has_serialized_format | default(false) }} },
{% endif %}
{% endfor %}
{% endfor %}
{% for child in ns.namespaces | default([]) %}
{{ generic_elements(child, current) }}
{% endfor %}
{% endmacro %}
{% for ns in json.namespaces | default([]) %}
{{ generic_elements(ns) }}
{% endfor %}
];

pub fn find_struct_field_accessor(
    struct_name: &str,
    field_name: &str,
) -> Option<&'static GeneratedStructFieldAccessor> {
    GENERATED_STRUCT_FIELD_ACCESSORS
        .iter()
        .find(|accessor| accessor.struct_name == struct_name && accessor.field_name == field_name)
}

pub fn find_generic_mw_com_element(
    service_name: &str,
    instance_name: &str,
    member_name: &str,
) -> Option<&'static GenericMwComElement> {
    GENERATED_GENERIC_MW_COM_ELEMENTS.iter().find(|element| {
        element.service_name == service_name
            && (element.instance_name == instance_name || element.instance_specifier == instance_name)
            && element.member_name == member_name
    })
}