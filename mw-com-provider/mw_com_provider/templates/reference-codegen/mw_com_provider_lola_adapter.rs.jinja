impl GeneratedReceiveSubscription {
    fn matches(&self, service_name: &str, instance_specifier: &str, member_name: &str) -> bool {
        match self {
            Self::NoReceive => false,
{% for ns in json.namespaces | default([]) -%}
{% for intf in ns.interfaces | default([]) -%}
{% for event in intf.events | default([]) if event.provider is defined and event.provider.vss.direction | default("datapoint") != "actuator" %}
            Self::{{ intf.name }}{{ event.name | replace("_", " ") | title | replace(" ", "") }} {
                instance_specifier: subscribed_instance,
                ..
            } => {
                service_name == "{{ intf.name }}"
                    && subscribed_instance == instance_specifier
                    && member_name == "{{ event.name }}"
            }
{% endfor -%}
{% endfor -%}
{% endfor %}
        }
    }

    fn unsubscribe(self) {
        match self {
            Self::NoReceive => {}
{% for ns in json.namespaces | default([]) -%}
{% for intf in ns.interfaces | default([]) -%}
{% for event in intf.events | default([]) if event.provider is defined and event.provider.vss.direction | default("datapoint") != "actuator" %}
            Self::{{ intf.name }}{{ event.name | replace("_", " ") | title | replace(" ", "") }} { subscription, .. } => {
                let _ = subscription.unsubscribe();
            }
{% endfor -%}
{% endfor -%}
{% endfor %}
        }
    }

    fn try_receive(
        &self,
        pending_messages: &mut VecDeque<MwComMessage>,
        receive_batch_size: usize,
    ) -> Result<(), MwComProviderError> {
        match self {
            Self::NoReceive => Ok(()),
{% for ns in json.namespaces | default([]) -%}
{% for intf in ns.interfaces | default([]) -%}
{% for event in intf.events | default([]) if event.provider is defined and event.provider.vss.direction | default("datapoint") != "actuator" %}
            Self::{{ intf.name }}{{ event.name | replace("_", " ") | title | replace(" ", "") }} {
                instance_name,
                subscription,
                ..
            } => {
                let mut samples = SampleContainer::new(receive_batch_size);
                let count = subscription
                    .try_receive(&mut samples, receive_batch_size)
                    .map_err(|error| LolaScoreRuntimeAdapter::score_error("SCORE {{ event.name }} receive failed", error))?;
                for _ in 0..count {
                    let sample = samples.pop_front().ok_or_else(|| {
                        MwComProviderError::Transport("SCORE {{ event.name }} receive returned no sample".into())
                    })?;
                    pending_messages.push_back(MwComMessage {
                        service: "{{ event.provider.service | default(intf.name) }}".into(),
                        instance: instance_name.clone(),
                        member: "{{ event.name }}".into(),
                        value: {{ mw_value_expr(rust_field_type(ns, event), "sample." ~ (event.provider.field | default("value"))) }},
                        source_timestamp: Some(SystemTime::now()),
                        quality: {% if struct_has_field(ns, event, "quality") == "true" %}score_quality(sample.quality)?{% else %}SignalQuality::Valid{% endif %},
                    });
                }
                Ok(())
            }
{% endfor -%}
{% endfor -%}
{% endfor %}
        }
    }
}

